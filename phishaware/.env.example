# Generated automatically by `serverless export-env` after a deployment.
# Copy this file to .env and populate it, or run `npx serverless export-env`
# to pull real values from the deployed CloudFormation stack.

# Deployment stage (dev | prod)
env=dev

# AWS region
region=eu-west-2

# Cognito User Pool ID — found in AWS Console > Cognito > User Pools
# Format: <region>_<alphanumeric>  e.g. eu-west-2_AbCdEfGhI
userPoolId=

# Cognito App Client ID — found in the User Pool's "App clients" section
userPoolClientId=
